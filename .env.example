# ============================================================
# Téranga Market — exemple de configuration (à copier en .env)
# Renseignez ces variables chez votre hébergeur (Hostinger →
# hPanel → Node.js → Variables d'environnement) puis redémarrez.
# ============================================================

# Base de données Supabase PostgreSQL (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.REF_PROJET:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?connection_limit=10&pool_timeout=20

# Connexion directe (migrations Prisma) — même serveur, sans les paramètres de pool
DIRECT_URL=postgresql://postgres.REF_PROJET:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Secret de signature des sessions (32 caractères minimum) — générez-en un unique :
#   openssl rand -hex 32
SESSION_SECRET=COLLEZ_ICI_UN_SECRET_DE_64_CARACTERES_HEXA

# URL publique du site (référencement, sitemap, réseaux sociaux)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ---- Supabase Auth (sauvegarde automatique des comptes en ligne) ----
# Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://REF_PROJET.supabase.co
# Supabase → Settings → API → « service_role » (clé SECRÈTE, côté serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=COLLEZ_ICI_LA_CLE_SERVICE_ROLE
